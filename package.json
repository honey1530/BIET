{
  "name": "biet-academic-os-monorepo",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "dev:student": "VITE_APP=student tsx server.ts",
    "dev:faculty": "VITE_APP=faculty tsx server.ts",
    "dev:principal": "VITE_APP=principal tsx server.ts",
    "dev:exam": "VITE_APP=exam tsx server.ts",
    "dev:parent": "VITE_APP=parent tsx server.ts",
    "build": "vite build",
    "build:student": "vite build --config apps/student-app/vite.config.ts",
    "build:principal": "vite build --config apps/principal-app/vite.config.ts",
    "build:faculty": "vite build --config apps/faculty-app/vite.config.ts",
    "build:exam": "vite build --config apps/exam-cell-app/vite.config.ts",
    "build:placement": "vite build --config apps/placement-app/vite.config.ts",
    "build:parent": "vite build --config apps/parent-app/vite.config.ts",
    "vercel-build": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
